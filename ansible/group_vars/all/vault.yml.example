# 이 파일을 복사해 평문으로 커밋하지 않는다.
# README의 `ansible-vault create` 명령으로 group_vars/all/vault.yml을 만든다.
vault_postgres_password: "32자 이상의 임의 문자열"
vault_cookie_secret: "서로 다른 32자 이상의 임의 문자열"
vault_capture_token_secret: "서로 다른 32자 이상의 임의 문자열"
vault_media_token_secret: "서로 다른 32자 이상의 임의 문자열"

# 팀원마다 고유한 Linux 계정과 SSH 공개키를 사용한다.
# 개인키는 절대로 이 파일에 넣지 않는다.
vault_ssh_users:
  - username: "team_member"
    public_key: "ssh-ed25519 AAAA... team_member@laptop"
