apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization

resources:
  - ../../k8s/overlays/prod

# 추적되는 prod 오버레이는 환경 구조만 담고, 배포할 불변 SHA 태그는 실행 시
# Ansible이 이 임시 오버레이에 주입한다.
images:
  - name: emoselfie-backend
    newName: {{ ecr_registry }}/{{ ecr_repository_backend }}
    newTag: {{ backend_tag }}
  - name: emoselfie-models
    newName: {{ ecr_registry }}/{{ ecr_repository_models }}
    newTag: {{ backend_tag }}
  - name: emoselfie-web
    newName: {{ ecr_registry }}/{{ ecr_repository_web }}
    newTag: {{ frontend_tag }}

