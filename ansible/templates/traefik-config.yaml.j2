# k3s의 deploy 컨트롤러가 /var/lib/rancher/k3s/server/manifests를 감시하다가 이
# 파일을 Addon으로 만들어 적용한다. 재시작이 필요 없고, 노드를 다시 만들어도
# Ansible이 파일을 다시 놓으면 복원된다.
#
# 이름과 네임스페이스가 대상 HelmChart(kube-system/traefik)와 모두 같아야
# 매칭된다. 다르면 에러 없이 조용히 무시되므로 값을 바꾸지 않는다.
apiVersion: helm.cattle.io/v1
kind: HelmChartConfig
metadata:
  name: traefik
  namespace: kube-system
spec:
  valuesContent: |-
    ports:
      web:
        forwardedHeaders:
          # 신뢰 범위를 여기 적힌 출발지로 좁힌다. insecure는 누가 보내든
          # X-Forwarded-*를 믿는다는 뜻이라 운영에서는 쓰지 않는다.
          trustedIPs:
{% for trusted_ip in traefik_trusted_ips %}
            - "{{ trusted_ip }}"
{% endfor %}
    # server 노드 한 대가 죽어도 입구가 남도록 노드 수만큼 replica를 두고
    # 노드당 1개로 강제한다. replicas만 늘리면 스케줄러가 몰아넣을 수 있다.
    deployment:
      replicas: {{ groups['k3s_servers'] | length }}
    topologySpreadConstraints:
      - maxSkew: 1
        topologyKey: kubernetes.io/hostname
        whenUnsatisfiable: DoNotSchedule
        labelSelector:
          matchLabels:
            app.kubernetes.io/name: traefik
